---
// Small fasting symbol: sprout (strict), grapes & oil (wine and oil), fish, cheese (dairy), star (fast-free).
const { fast, label = '' } = Astro.props;
---
{fast !== 'none' && (
  <svg class="fast-icon" viewBox="0 0 32 32" role="img" aria-label={label}>
    <title>{label}</title>
    <circle cx="16" cy="16" r="15" fill="#fffaf0" stroke="#c9961a" stroke-width="1.5" />
    {fast === 'strict' && (<>
      <path d="M16 26V14" stroke="#3f7a32" stroke-width="2" stroke-linecap="round" />
      <path d="M16 16c-1-5-5-7-9-6 1 4 4 7 9 6zM16 14c1-5 5-7 9-6-1 4-4 7-9 6z" fill="#6aa84f" stroke="#2f5e2a" stroke-width="1" />
    </>)}
    {fast === 'wine-oil' && (<>
      {[[12, 11], [17, 11], [14.5, 15], [19.5, 15], [17, 19], [12, 15], [14.5, 19], [15.5, 23]].map(([x, y]) => <circle cx={x - 1} cy={y} r="2.6" fill="#6b2e6e" stroke="#3a2616" stroke-width=".6" />)}
      <path d="M15 8q2-3 5-3" stroke="#3f7a32" stroke-width="1.6" fill="none" stroke-linecap="round" />
      <path d="M24 14q3 5 0 7q-3-2 0-7z" fill="#e0b52a" stroke="#a77a10" stroke-width=".8" />
    </>)}
    {fast === 'fish' && (<>
      <path d="M6 16q8-9 16 0q-8 9-16 0z" fill="#4f95c7" stroke="#1c3765" stroke-width="1.2" />
      <path d="M22 16l5-5v10z" fill="#4f95c7" stroke="#1c3765" stroke-width="1.2" />
      <circle cx="10.5" cy="15" r="1.3" fill="#1c3765" />
    </>)}
    {fast === 'dairy' && (<>
      <path d="M6 21l18-9 2 9z" fill="#f4d468" stroke="#a77a10" stroke-width="1.2" />
      <path d="M6 21h20v4H6z" fill="#e8bf3c" stroke="#a77a10" stroke-width="1.2" />
      <circle cx="15" cy="18" r="1.4" fill="#d9a521" /><circle cx="20" cy="17" r="1" fill="#d9a521" />
    </>)}
    {fast === 'free' && (
      <path d="M16 4l3 8 8 1-6 6 2 9-7-5-7 5 2-9-6-6 8-1z" fill="#f0cf62" stroke="#a8281f" stroke-width="1.3" />
    )}
  </svg>
)}
