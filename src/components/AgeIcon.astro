---
const { kind } = Astro.props;
---
<svg viewBox="0 0 64 64" aria-hidden="true">
  <circle cx="32" cy="32" r="30" fill="#fbf0c8" stroke="#c9961a" stroke-width="2" />
  {kind === 'lamb' && (<>
    <g fill="#fffaf0" stroke="#3a2616" stroke-width="1.4">
      <circle cx="22" cy="34" r="7" /><circle cx="30" cy="30" r="8" /><circle cx="38" cy="33" r="7" /><circle cx="28" cy="38" r="7" /><circle cx="36" cy="39" r="6" />
    </g>
    <ellipse cx="45" cy="29" rx="5" ry="6" fill="#3a2616" />
    <path d="M24 44v7M30 45v7M36 45v7M41 43v7" stroke="#3a2616" stroke-width="2.4" stroke-linecap="round" />
  </>)}
  {kind === 'lantern' && (<>
    <circle cx="32" cy="34" r="16" fill="#ffe27a" opacity=".5" />
    <path d="M26 14h12l2 6H24z" fill="#a8281f" stroke="#3a2616" stroke-width="1.2" />
    <rect x="24" y="20" width="16" height="22" rx="3" fill="#ffd765" stroke="#3a2616" stroke-width="1.4" />
    <path d="M32 23q-3 5 0 10q3-5 0-10z" fill="#e8701c" />
    <path d="M24 42h16l-2 6H26z" fill="#a8281f" stroke="#3a2616" stroke-width="1.2" />
    <path d="M28 14q4-6 8 0" fill="none" stroke="#3a2616" stroke-width="1.4" />
  </>)}
  {kind === 'scroll' && (<>
    <rect x="18" y="16" width="28" height="32" fill="#f6ecd2" stroke="#3a2616" stroke-width="1.4" />
    <ellipse cx="32" cy="16" rx="16" ry="4" fill="#e3cf9e" stroke="#3a2616" stroke-width="1.4" />
    <ellipse cx="32" cy="48" rx="16" ry="4" fill="#e3cf9e" stroke="#3a2616" stroke-width="1.4" />
    <path d="M23 24h18M23 29h14M23 34h18M23 39h12" stroke="#7f1d18" stroke-width="1.6" stroke-linecap="round" />
  </>)}
</svg>
