---
import '../styles/global.css';
import Emblem from '../components/Emblem.astro';
import { t } from '../lib/i18n.js';
import { u } from '../lib/url.js';

const { title, description = t('siteTagline'), lang = 'en', active = '' } = Astro.props;
const fullTitle = title ? `${title} · ${t('siteTitle', lang)}` : t('siteTitle', lang);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#7f1d18" />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Alegreya:ital,wght@0,400;0,700;1,400&family=Cinzel:wght@400;700&family=Cinzel+Decorative:wght@700&display=swap" rel="stylesheet" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={u('/')}>
          <Emblem />
          <span class="brand-title">{t('siteTitle', lang)}<span class="brand-sub">{t('siteTagline', lang)}</span></span>
        </a>
        <nav class="site-nav" aria-label="Main">
          <a href={u('/calendar/2027/01/')} aria-current={active === 'calendar' ? 'page' : undefined}>{t('nav.calendar', lang)}</a>
          <a href={u('/saints/')} aria-current={active === 'saints' ? 'page' : undefined}>{t('nav.saints', lang)}</a>
          <a href={u('/about/')} aria-current={active === 'about' ? 'page' : undefined}>{t('nav.about', lang)}</a>
        </nav>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <svg class="ornament" viewBox="0 0 160 24" aria-hidden="true"><path d="M2 12h56M102 12h56" stroke="#c9961a" stroke-width="2" /><path d="M80 2l6 10-6 10-6-10z" fill="#a8281f" stroke="#c9961a" /><circle cx="64" cy="12" r="3" fill="#23498a" /><circle cx="96" cy="12" r="3" fill="#23498a" /></svg>
        <p>{t('footer.note', lang)}</p>
      </div>
    </footer>
  </body>
</html>
